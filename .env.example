# ───────────────────────────────────────────────────────────────
# Swarm Command & Control — Environment Configuration
# ───────────────────────────────────────────────────────────────
# Copy this to .env and fill in values.
# NEVER commit .env to git.
# ───────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
APP_NAME=SwarmCommandControl
APP_ENV=development
APP_PORT=8000

# ── Database ─────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scc
POSTGRES_USER=scc
POSTGRES_PASSWORD=scc
POSTGRES_DSN=postgresql+asyncpg://scc:scc@localhost:5432/scc

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Kafka ────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=scc-backend

# ── MQTT (Drone Telemetry) ──────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883

# ── Triton Inference Server ─────────────────────────────────
TRITON_URL=http://localhost:8000
TRITON_GRPC_URL=localhost:8001

# ── MinIO ────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=sccminio
MINIO_SECRET_KEY=sccminio123
MINIO_BUCKET=scc-media

# ── MLflow ──────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Auth / JWT ──────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── IMD API ─────────────────────────────────────────────────
IMD_API_BASE_URL=https://api.imd.gov.in
IMD_API_KEY=your-imd-api-key

# ── ERSS/112 Integration ────────────────────────────────────
ERSS_API_BASE_URL=https://erss.example.gov.in/api
ERSS_API_KEY=your-erss-api-key

# ── State Configuration ─────────────────────────────────────
DEFAULT_STATE=UT  # Uttarakhand for pilot
DEFAULT_DISTRICT=DDN  # Dehradun

# ── Drone Simulation ────────────────────────────────────────
SIM_NUM_MOTHERS=1
SIM_DRONES_PER_LEGION=25
SIM_TELEMETRY_INTERVAL_MS=200

# ── SLAs (seconds) ─────────────────────────────────────────
SLA_AI_TRIAGE_MAX=30
SLA_HUMAN_REVIEW_MAX=120
SLA_SWARM_DISPATCH_MAX=300
SLA_AUTO_APPROVE_ON_TIMEOUT=true

# =============================================================================
# Swarm Command & Control - .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
venv/
.venv/
env/
.env
*.pkl
*.joblib

# --- Go ---
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
go.work.sum

# --- Node / TypeScript / React ---
node_modules/
.next/
out/
.nuxt/
.cache/
*.tsbuildinfo
.turbo/
.vercel/
.expo/
dist/
bundle/

# --- React Native ---
.android/
.ios/
*.jks
*.keystore
build/
android/app/build/
ios/build/
ios/Pods/

# --- Docker ---
*.dockerignore

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Terraform ---
**/*.tfstate
**/*.tfstate.*
.terraform/
.terraform.lock.hcl
terraform.tfvars
*.tfplan

# --- Vault ---
vault-data/
*.hcl_secret

# --- Secrets ---
*.pem
*.key
*.crt
*.p12
secrets.yaml
secrets.json

# --- Data / ML ---
ai-ml/models/**/*.pt
ai-ml/models/**/*.pth
ai-ml/models/**/*.onnx
ai-ml/models/**/*.engine
ai-ml/data/datasets/*
!ai-ml/data/datasets/.gitkeep
ai-ml/mlflow/artifacts/*
!ai-ml/mlflow/artifacts/.gitkeep

# --- Logs ---
*.log
logs/

# --- Kafka ---
kafka-data/
zookeeper-data/

# --- Redis ---
redis-data/

# --- PostgreSQL ---
pg-data/

# --- MinIO ---
minio-data/

# --- Temp ---
tmp/
temp/
